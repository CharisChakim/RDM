import { Button, LineEdit, CheckBox, SpinBox, ListView, Palette } from "std-widgets.slint";

export struct Row {
    id: int,
    name: string,
    // "ZIP", "MP4"... for the file-type chip
    ext: string,
    // 0 other, 1 compressed, 2 documents, 3 music, 4 programs, 5 video
    cat: int,
    size: string,
    status: string,
    // 0 downloading, 1 paused, 2 completed, 3 error
    kind: int,
    pct: float,
    bar: bool,
    left: string,
    rate: string,
    conns: string,
    added: string,
    tip: string,
    selected: bool,
}

export struct Category {
    key: string,
    label: string,
    count: string,
    header: bool,
}

// Fractions of the detail bar: where a connection's segment starts and how much it has received.
export struct Seg {
    x: float,
    done: float,
}

export struct Quality {
    label: string,
    note: string,
}

global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> text: dark ? #e3e8ef : #1c2430;
    out property <color> muted: dark ? #8b95a5 : #687385;
    out property <color> hover: dark ? #222a34 : #eef2f8;
    out property <color> selected: dark ? #1e3150 : #dbe8fd;
    out property <color> accent: dark ? #4c8dff : #1f6feb;
    out property <color> accent-hover: dark ? #6aa0ff : #1858c4;
    out property <color> line: dark ? #2b323c : #e1e5eb;
    out property <color> panel: dark ? #1b2027 : #ffffff;
    out property <color> page: dark ? #14181e : #f4f6f9;
    out property <color> bar-bg: dark ? #262d37 : #e6ebf1;
    out property <color> bar-fill: dark ? #3b82f6 : #2f81f7;
    out property <color> ok: dark ? #3fb950 : #1a7f37;
    out property <color> warn: dark ? #d29922 : #9a6700;
    out property <color> err: dark ? #f85149 : #cf222e;

    // file-type chip colours, by category
    public pure function cat-color(cat: int) -> color {
        if (cat == 1) { return dark ? #e3b341 : #9a6700; }
        if (cat == 2) { return dark ? #ff9a5c : #c4430b; }
        if (cat == 3) { return dark ? #f778ba : #bf3989; }
        if (cat == 4) { return dark ? #39c5cf : #0e7c86; }
        if (cat == 5) { return dark ? #a371f7 : #8250df; }
        return dark ? #8b95a5 : #687385;
    }

    public pure function status-color(kind: int) -> color {
        if (kind == 1) { return warn; }
        if (kind == 2) { return ok; }
        if (kind == 3) { return err; }
        return accent;
    }
}

component Separator inherits Rectangle {
    width: 1px;
    height: 22px;
    background: Theme.line;
}

// Toolbar button: icon + label side by side; the primary one is filled with the accent colour.
component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: root.primary ? (ta.has-hover ? Theme.accent-hover : Theme.accent) : (ta.has-hover && root.enabled ? Theme.hover : transparent);
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 17px;
                height: 17px;
                colorize: root.primary ? #ffffff : Theme.text;
                opacity: root.enabled ? 1 : 0.35;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-weight: root.primary ? 600 : 400;
            color: root.primary ? #ffffff : Theme.text;
            opacity: root.enabled ? 1 : 0.4;
        }
    }
}

component Cell inherits Text {
    vertical-alignment: center;
    overflow: elide;
    color: Theme.text;
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    width: 38px;
    height: 22px;
    border-radius: 5px;
    background: root.tint.with-alpha(Theme.dark ? 0.22 : 0.12);
    Text {
        text: root.label;
        font-size: 10px;
        font-weight: 700;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StatusPill inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    height: 22px;
    border-radius: 11px;
    background: Theme.status-color(root.kind).with-alpha(Theme.dark ? 0.2 : 0.11);
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            color: Theme.status-color(root.kind);
        }
    }
}

component RowView inherits Rectangle {
    in property <Row> entry;
    in property <bool> narrow;
    callback pressed(int, bool, bool);
    callback activated(int);
    height: 40px;
    background: root.entry.selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pressed(root.entry.id, e.modifiers.control, e.modifiers.shift);
            }
        }
        double-clicked => { root.activated(root.entry.id); }
    }
    if root.entry.selected: Rectangle {
        x: 0;
        width: 3px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Chip { label: root.entry.ext; tint: Theme.cat-color(root.entry.cat); }
        }
        Cell { text: root.entry.name; horizontal-stretch: 1; min-width: 80px; font-weight: 500; }
        Cell { text: root.entry.size; width: 76px; color: Theme.muted; }
        HorizontalLayout {
            width: 150px;
            spacing: 8px;
            alignment: start;
            if root.entry.kind != 0: VerticalLayout {
                alignment: center;
                StatusPill { text: root.entry.status; kind: root.entry.kind; }
            }
            if root.entry.kind == 0: Cell {
                text: root.entry.status;
                width: 46px;
                font-weight: 600;
                color: Theme.accent;
            }
            if root.entry.bar: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 6px;
                    width: 88px;
                    border-radius: 3px;
                    background: Theme.bar-bg;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.entry.pct;
                        border-radius: 3px;
                        background: Theme.bar-fill;
                    }
                }
            }
        }
        if !root.narrow: Cell { text: root.entry.left; width: 70px; color: Theme.muted; }
        Cell { text: root.entry.rate; width: 92px; }
        if !root.narrow: Cell { text: root.entry.conns; width: 44px; color: Theme.muted; horizontal-alignment: center; }
        Cell { text: root.entry.added; width: 108px; color: Theme.muted; }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
        opacity: 0.7;
    }
}

component HeaderCell inherits Text {
    vertical-alignment: center;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: Theme.muted;
    overflow: elide;
}

component SideItem inherits Rectangle {
    in property <Category> item;
    in property <bool> active;
    callback chosen(string);
    height: self.item.header ? 32px : 34px;
    border-radius: 8px;
    background: root.active ? Theme.selected : ta.has-hover && !root.item.header ? Theme.hover : transparent;
    ta := TouchArea {
        enabled: !root.item.header;
        mouse-cursor: root.item.header ? default : pointer;
        clicked => { root.chosen(root.item.key); }
    }
    if root.active: Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: root.item.header ? 10px : 12px;
        padding-right: 10px;
        spacing: 10px;
        if !root.item.header: VerticalLayout {
            alignment: center;
            Image {
                width: 17px;
                height: 17px;
                colorize: root.active ? Theme.accent : Theme.muted;
                source: root.item.key == "all" ? @image-url("icons/cat-all.svg")
                    : root.item.key == "compressed" ? @image-url("icons/cat-compressed.svg")
                    : root.item.key == "documents" ? @image-url("icons/cat-documents.svg")
                    : root.item.key == "music" ? @image-url("icons/cat-music.svg")
                    : root.item.key == "programs" ? @image-url("icons/cat-programs.svg")
                    : root.item.key == "video" ? @image-url("icons/cat-video.svg")
                    : root.item.key == "unfinished" ? @image-url("icons/cat-unfinished.svg")
                    : @image-url("icons/cat-finished.svg");
            }
        }
        Text {
            text: root.item.label;
            vertical-alignment: root.item.header ? bottom : center;
            font-size: root.item.header ? 11px : 13px;
            font-weight: root.item.header ? 600 : root.active ? 600 : 400;
            letter-spacing: root.item.header ? 0.6px : 0;
            color: root.item.header ? Theme.muted : root.active ? Theme.accent : Theme.text;
            horizontal-stretch: 1;
        }
        if root.item.count != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                min-width: 24px;
                border-radius: 10px;
                background: root.active ? Theme.accent : Theme.bar-bg;
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    Text {
                        text: root.item.count;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: root.active ? #ffffff : Theme.muted;
                    }
                }
            }
        }
    }
}

component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
}

component Modal inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 520px;
    background: #00000066;
    TouchArea { }
    Rectangle {
        width: min(root.card-width, root.width - 40px);
        height: body.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 6px;
        body := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.title;
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
            }
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "RDM - Rust Download Manager";
    icon: @image-url("icons/app.png");
    preferred-width: 1120px;
    preferred-height: 660px;
    min-width: 760px;
    min-height: 420px;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    background: Theme.page;

    in property <[Row]> rows;
    in property <[Category]> categories;
    in property <string> filter: "all";
    in property <string> totals;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <bool> can-delete;
    in property <bool> can-open-folder;
    in property <bool> empty;

    in property <bool> detail;
    in property <string> d-name;
    in property <string> d-stats;
    in property <string> d-url;
    in property <string> d-path;
    in property <[Seg]> segs;

    // "", "add", "quality", "options", "delete"
    in-out property <string> dialog;
    in-out property <string> add-url;
    in property <string> quality-title;
    in property <[Quality]> qualities;
    in-out property <int> quality-index;
    in property <string> quality-message;
    in-out property <string> opt-dir;
    in-out property <int> opt-conns;
    in-out property <bool> opt-autostart;
    in property <int> delete-count;

    callback row-pressed(int, bool, bool);
    callback row-activated(int);
    callback filter-chosen(string);
    callback add-clicked();
    callback add-submit(string);
    callback quality-accept(int);
    callback resume-clicked();
    callback stop-clicked();
    callback delete-clicked();
    callback delete-confirm(bool);
    callback clean-clicked();
    callback folder-clicked();
    callback options-clicked();
    callback options-save();
    callback browse-clicked();
    callback select-all();
    callback paste();

    // Narrow windows drop Time Left and Conn. so the file name keeps its room. Updated on resize
    // rather than bound, because the columns themselves feed into the window's minimum width.
    property <bool> narrow: false;
    changed width => {
        self.narrow = self.width < 1040px;
    }

    // Keyboard shortcuts for the list, like IDM: Delete, Ctrl+A, Ctrl+V (paste a URL to add it).
    keys := FocusScope {
        key-pressed(e) => {
            if (root.dialog != "") {
                if (e.text == Key.Escape) {
                    root.dialog = "";
                    return accept;
                }
                return reject;
            }
            if (e.text == Key.Delete) {
                root.delete-clicked();
                return accept;
            }
            if (e.modifiers.control && (e.text == "a" || e.text == "A")) {
                root.select-all();
                return accept;
            }
            if (e.modifiers.control && (e.text == "v" || e.text == "V")) {
                root.paste();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // toolbar
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    padding-right: 14px;
                    VerticalLayout {
                        alignment: center;
                        Image { source: @image-url("icons/app.png"); width: 26px; height: 26px; }
                    }
                    Text { text: "RDM"; font-size: 17px; font-weight: 700; vertical-alignment: center; color: Theme.text; }
                }
                ToolButton { icon: @image-url("icons/add.svg"); text: "Add URL"; primary: true; clicked => { root.add-clicked(); } }
                VerticalLayout { alignment: center; padding-left: 4px; padding-right: 4px; Separator { } }
                ToolButton { icon: @image-url("icons/play.svg"); text: "Resume"; enabled: root.can-resume; clicked => { root.resume-clicked(); } }
                ToolButton { icon: @image-url("icons/pause.svg"); text: "Stop"; enabled: root.can-stop; clicked => { root.stop-clicked(); } }
                VerticalLayout { alignment: center; padding-left: 4px; padding-right: 4px; Separator { } }
                ToolButton { icon: @image-url("icons/trash.svg"); text: "Delete"; enabled: root.can-delete; clicked => { root.delete-clicked(); } }
                ToolButton { icon: @image-url("icons/clean.svg"); text: "Delete Completed"; clicked => { root.clean-clicked(); } }
                VerticalLayout { alignment: center; padding-left: 4px; padding-right: 4px; Separator { } }
                ToolButton { icon: @image-url("icons/folder.svg"); text: "Open Folder"; enabled: root.can-open-folder; clicked => { root.folder-clicked(); } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.totals; vertical-alignment: center; color: Theme.muted; }
                Rectangle { width: 10px; }
                ToolButton { icon: @image-url("icons/gear.svg"); text: "Options"; clicked => { root.options-clicked(); } }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                padding-left: 10px;
                padding-right: 14px;
                padding-bottom: 14px;
                spacing: 12px;
                // sidebar
                VerticalLayout {
                    width: 186px;
                    alignment: start;
                    spacing: 2px;
                    for c in root.categories: SideItem {
                        item: c;
                        active: c.key == root.filter;
                        chosen(key) => { root.filter-chosen(key); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    // list
                    Card {
                        vertical-stretch: 1;
                        VerticalLayout {
                            Rectangle {
                                height: 36px;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    Rectangle { width: 38px; }
                                    HeaderCell { text: "FILE NAME"; horizontal-stretch: 1; min-width: 80px; }
                                    HeaderCell { text: "SIZE"; width: 76px; }
                                    HeaderCell { text: "STATUS"; width: 150px; }
                                    if !root.narrow: HeaderCell { text: "TIME LEFT"; width: 70px; }
                                    HeaderCell { text: "SPEED"; width: 92px; }
                                    if !root.narrow: HeaderCell { text: "CONN."; width: 44px; horizontal-alignment: center; }
                                    HeaderCell { text: "ADDED"; width: 108px; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                            }
                            ListView {
                                vertical-stretch: 1;
                                for r in root.rows: RowView {
                                    entry: r;
                                    narrow: root.narrow;
                                    pressed(id, ctrl, shift) => {
                                        keys.focus();
                                        root.row-pressed(id, ctrl, shift);
                                    }
                                    activated(id) => { root.row-activated(id); }
                                }
                            }
                        }
                        if root.empty: VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            HorizontalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/app.png"); width: 56px; height: 56px; opacity: 0.85; }
                            }
                            Text {
                                text: "No downloads yet";
                                font-size: 15px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                color: Theme.text;
                            }
                            Text {
                                text: "Click Add URL, or download something in your browser.";
                                horizontal-alignment: center;
                                color: Theme.muted;
                            }
                        }
                    }

                    // details of the selected download, with IDM's per-connection bar
                    if root.detail: Card {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: root.d-name; font-size: 14px; font-weight: 600; overflow: elide; horizontal-stretch: 1; color: Theme.text; }
                                Text { text: root.d-stats; color: Theme.muted; vertical-alignment: center; }
                            }
                            Rectangle {
                                height: 12px;
                                border-radius: 6px;
                                background: Theme.bar-bg;
                                clip: true;
                                for s in root.segs: Rectangle {
                                    x: parent.width * s.x;
                                    width: parent.width * s.done;
                                    background: Theme.bar-fill;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: root.d-url; font-size: 12px; color: Theme.muted; overflow: elide; horizontal-stretch: 1; }
                                Text { text: root.d-path; font-size: 12px; color: Theme.muted; overflow: elide; horizontal-stretch: 1; horizontal-alignment: right; }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.dialog == "add": Modal {
        title: "Add URL";
        Text { text: "A file link, an .m3u8 stream, or a video page (YouTube, Vimeo, Instagram\u{2026})"; color: Theme.muted; wrap: word-wrap; }
        url := LineEdit {
            placeholder-text: "https://";
            text <=> root.add-url;
            init => { self.focus(); }
            accepted => { root.add-submit(self.text); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { root.dialog = ""; keys.focus(); } }
            Button { text: "Download"; primary: true; clicked => { root.add-submit(url.text); } }
        }
    }

    if root.dialog == "quality": Modal {
        title: root.quality-title;
        if root.quality-message != "": Text {
            text: root.quality-message;
            color: Theme.muted;
            wrap: word-wrap;
        }
        if root.qualities.length > 0: Rectangle {
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 8px;
            height: min(root.qualities.length * 38px, 342px);
            clip: true;
            ListView {
                for q[i] in root.qualities: Rectangle {
                    height: 38px;
                    background: i == root.quality-index ? Theme.selected : qa.has-hover ? Theme.hover : transparent;
                    qa := TouchArea {
                        clicked => { root.quality-index = i; }
                        double-clicked => { root.quality-accept(i); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: i == root.quality-index ? "\u{25C9}" : "\u{25CB}"; vertical-alignment: center; color: Theme.accent; }
                        Text { text: q.label; vertical-alignment: center; horizontal-stretch: 1; color: Theme.text; font-weight: i == root.quality-index ? 600 : 400; }
                        Text { text: q.note; vertical-alignment: center; font-size: 12px; color: Theme.muted; }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { root.dialog = ""; keys.focus(); } }
            Button {
                text: "Download";
                primary: true;
                enabled: root.qualities.length > 0;
                clicked => { root.quality-accept(root.quality-index); }
            }
        }
    }

    if root.dialog == "options": Modal {
        title: "Options";
        Text { text: "Save to"; color: Theme.muted; }
        HorizontalLayout {
            spacing: 6px;
            LineEdit { text <=> root.opt-dir; horizontal-stretch: 1; }
            Button { text: "Browse\u{2026}"; clicked => { root.browse-clicked(); } }
        }
        Text { text: "Connections per download (1\u{2013}32)"; color: Theme.muted; }
        SpinBox { minimum: 1; maximum: 32; value <=> root.opt-conns; }
        CheckBox { text: "Start with Windows (in the tray, so the browser extension always works)"; checked <=> root.opt-autostart; }
        Text {
            text: "Closing this window keeps RDM running in the tray. Use the tray icon's Quit to exit.";
            font-size: 12px;
            color: Theme.muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { root.dialog = ""; keys.focus(); } }
            Button { text: "Save"; primary: true; clicked => { root.options-save(); } }
        }
    }

    if root.dialog == "delete": Modal {
        title: "Delete " + root.delete-count + (root.delete-count == 1 ? " download?" : " downloads?");
        Text { text: "Remove from the list only, or also delete the files from disk?"; color: Theme.text; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; clicked => { root.dialog = ""; keys.focus(); } }
            Button { text: "Remove from list"; clicked => { root.delete-confirm(false); } }
            Button { text: "Delete files too"; primary: true; clicked => { root.delete-confirm(true); } }
        }
    }

    init => { keys.focus(); }
}
