{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDM",
  "version": "0.1.0",
  "identifier": "dev.rdm.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RDM - Rust Download Manager",
        "width": 1120,
        "height": 660,
        "minWidth": 760,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
